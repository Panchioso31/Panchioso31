# Copia este archivo como ".env" y completa tus datos. Nunca subas el .env a GitHub.

# Tu cuenta de https://ais.usvisa-info.com/es-pe/niv
USVISA_EMAIL=
USVISA_PASSWORD=

# Fecha de tu cita actual (AAAA-MM-DD). Solo se reserva algo anterior a esta fecha.
CURRENT_APPOINTMENT_DATE=2027-06-15

# Fecha más temprana que aceptas (AAAA-MM-DD). Vacío = desde hoy.
MIN_DATE=
# Días en que NO puedes ir (rangos AAAA-MM-DD:AAAA-MM-DD separados por comas). Vacío = ninguno.
EXCLUDE_DATES=

# true = solo avisa, no reserva. Cambia a false para que reprograme solo.
DRY_RUN=true

# Segundos entre consultas. Por debajo de ~30 el sitio suele bloquear la cuenta.
CHECK_INTERVAL_SECONDS=60
# Pausa cuando el sitio responde con error (posible bloqueo).
BLOCK_COOLDOWN_SECONDS=1800
# Intentos de reserva sin confirmar antes de detenerse (protege tus cambios de cita).
MAX_BOOKING_ATTEMPTS=3

# 115 = Embajada en Lima
LOCALE=es-pe
FACILITY_ID=115
# Número en la URL .../schedule/XXXXXXXX/... (vacío = se detecta solo)
SCHEDULE_ID=

# Opcional: aviso por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
